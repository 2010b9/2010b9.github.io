# GitHub Pages builds this site automatically on push — you don't need Ruby
# to publish. This Gemfile is only for previewing locally:
#
#   bundle install            # once
#   bundle exec jekyll serve  # then open http://localhost:4000
#
# Note: we use the plain `jekyll` gem (not the `github-pages` gem) because the
# latter pins very old dependencies that don't build on modern Ruby. This site
# uses no GitHub-Pages-only plugins, so a plain Jekyll build renders the same
# output GitHub Pages produces.
source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.9"   # required for local serving on Ruby 3+
